{
    "version": 1.0,
    "case": {
        "mesh_file": "cylinder.nmsh",
        "output_at_end": true,
        "output_boundary": true,
        "output_checkpoints": false,
        "output_directory": "results_insitu",
        "checkpoint_control": "simulationtime",
        "restart_file": "fluid00004.chkp",
        "checkpoint_value": 50.0,
        "time": {
            "end_time": 203.0,
            "variable_timestep": true,
            "target_cfl": 0.5,
            "max_timestep": 1e-1
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 9,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",        
            "_output_format": "vtkhdf",
            "Re": 400.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-5,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-3,
                "max_iterations": 50
            },
"boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow+dong",
                    "zone_indices": [ 2 ]
                },
                {
                    "type": "normal_outflow",
                    "value": [1.0, 0.0, 0.0],
                    "zone_indices": [ 5 ]
                },
                {
                    "type": "normal_outflow",
                    "value": [1.0, 0.0, 0.0],
                    "zone_indices": [ 6 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 7 ]
                }
            ],
            "output_control": "simulationtime",
            "output_value": 1.0
        },
        "constants": 
        [
          {
            "name": "strm_update_freq",
            "value": 15
          } 
        ],
        "simulation_components":
        [
            {
                "comment": "Stored in the temperature field, check docs for more details",
                "type": "lambda2",
                "compute_control": "tsteps",
                "compute_value": "strm_update_freq"
            },
            {
                "type": "data_streamer", 
                "fields": ["u", "v", "w", "lambda2"],
                "stream_mesh": true,
                "compute_control": "tsteps",
                "compute_value": "strm_update_freq"
            }
        ]
    }
}
