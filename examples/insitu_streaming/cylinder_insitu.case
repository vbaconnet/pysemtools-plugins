{
    "version": 1.0,
    "case": {
        "mesh_file": "n3.nmsh",
        "output_at_end": true,
        "output_boundary": true,
        "output_checkpoints": false,
        "output_directory": "results_insitu",
        "checkpoint_control": "simulationtime",
        "checkpoint_value": 50.0,
        "time": {
            "end_time": 1.0,
            "variable_timestep": true,
            "target_cfl": 0.5,
            "max_timestep": 1e-1
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 3,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 200.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 1.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-5,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-3,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow+dong",
                    "zone_indices": [ 4 ]
                },
                {
                    "type": "normal_outflow",
                    "value": [1.0, 0.0, 0.0],
                    "zone_indices": [ 3 ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "simulationtime",
            "output_value": 25.0
        },
        "constants": 
        [
          {
            "name": "strm_update_freq",
            "value": 1
          } 
        ],
        "simulation_components":
        [
            {
                "comment": "Stored in the temperature field, check docs for more details",
                "type": "lambda2",
                "compute_control": "fluid_output"
            },
            {
                "type": "wall_shear_stress",
                "name": "wss",
                "zone_indices": [2],
                "computed_field": "tau",
                "components": ["x"],
                "compute_control": "tsteps",
                "compute_value": 10
            },
            {
                "comment": "Stored in scalar 1,2,3. Changes order if simcomp is added before lambda2",
                "type": "curl",
                "fields": [ "u", "v", "w" ],
                "compute_control": "tsteps",
                "compute_value": "strm_update_freq"
            },
            {
                "type": "data_streamer", 
                "fields": ["u", "tau_x"],
                "stream_mesh": true,
                "compute_control": "tsteps",
                "compute_value": "strm_update_freq"
            }
        ]
    }
}
